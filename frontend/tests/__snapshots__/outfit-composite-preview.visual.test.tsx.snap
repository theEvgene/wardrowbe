  class="relative grid aspect-[4/5] w-full grid-cols-[minmax(64px,0.8fr)_minmax(0,2fr)_minmax(64px,0.8fr)] grid-rows-6 gap-2 overflow-hidden rounded-xl bg-gradient-to-b from-muted/40 to-muted p-3 sm:gap-3 sm:p-4"
